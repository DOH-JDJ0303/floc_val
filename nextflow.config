manifest {
    name            = 'floc-consistency'
    description     = 'Consistency of floc clustering across batch sizes, checked against pairwise SNP distances'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.1.0'
}

params {
    // input / output
    assemblies    = null          // directory of assemblies (.fa/.fasta/.fna, optionally .gz)
    outdir        = 'results'
    distance_matrix = null        // all-vs-all SNP distances (long or square); skips SKA2 when set

    // batch sizes: either a list, e.g. '10,50', or start/step/stop.
    // The all-samples-in-one-batch reference run is always added.
    batch_sizes   = null
    start         = 1
    step          = 10
    stop          = null

    // random subset of samples (seeded with --seed); 0 = use every assembly
    max_samples   = 50

    // sample order (one order is used for every batch size)
    shuffle       = true
    seed          = 1

    // floc
    floc_args     = ''            // extra floc options, e.g. '-d 0.03 --min-hash-frac 0'

    // SKA2 SNP distances (all pairs of samples)
    core          = 'pairwise'    // pairwise | global
    ska_k         = 31

    // pairs closer than this many SNPs are flagged when floc puts them in different clusters
    snp_threshold = 100

    // containers
    floc_container = 'public.ecr.aws/o8h2f0o1/floc:1.2.1'
    ska_container  = 'staphb/ska2:0.5.1'
}

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'floc' {
        container = params.floc_container
        cpus      = 2
        memory    = { 8.GB * task.attempt }
        time      = { 24.h * task.attempt }
    }
    withLabel: 'ska' {
        container = params.ska_container
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 8.h * task.attempt }
    }
    withLabel: 'small' {
        cpus      = 1
        memory    = { 4.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }
}

// Containers are used for every process. On Seqera Platform (AWS Batch, Google
// Batch, Azure Batch) the compute environment runs them; locally, Docker does.
// The floc image runs as a non-root user, so run containers as the calling user.
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

profiles {
    singularity {
        docker.enabled          = false
        singularity.enabled     = true
        singularity.autoMounts  = true
    }
    apptainer {
        docker.enabled          = false
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
    // run with tools already on PATH (floc, ska, python3), no containers
    local_tools {
        docker.enabled          = false
    }
}
